# --- Directorio base (opcional) ---
# Donde la aplicación guarda los datos (base de datos, documentos,
# respaldos, logs). Por defecto: en desarrollo, la raíz del proyecto;
# en la app instalada, %LOCALAPPDATA%\SistemaGestionPersonal. Defina
# SGP_BASE_DIR para una instalación portable o para pruebas aisladas.
#SGP_BASE_DIR=C:\SistemaGestionPersonal\datos

# Database Configuration
DATABASE_URL=sqlite:///personal_management.db
DATABASE_PATH=personal_management.db

# Application Configuration
APP_NAME=Sistema de Gestión de Personal
APP_VERSION=3.0.1
DEBUG=False

# File Storage
DOCUMENTS_PATH=documents
PHOTOS_PATH=photos
EXPORTS_PATH=exports

# PDF Configuration
PDF_AUTHOR=Sistema de Gestión de Personal
PDF_TITLE=Documentos Oficiales

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# --- Sincronización entre puestos de la intranet (agente) ---
# Estas variables sobrescriben lo guardado en config.json, de modo que un
# despliegue puede fijar el servidor y el token sin tocar la interfaz. Si no
# se definen, la sincronización se configura desde la aplicación
# (Configuración -> Sincronización).
#SDP_SYNC_ACTIVADO=true
#SDP_SYNC_URL=http://servidor-central:8765
#SDP_SYNC_TOKEN=token-que-entrega-el-administrador
#SDP_SYNC_EQUIPO=Secretaria
#SDP_SYNC_INTERVALO=30
# Tamaño máximo del contenido binario que viaja por la red (bytes)
#SDP_SYNC_BINARIO_MAX=5242880
