<?xml version="1.0" encoding="utf-8"?>
<!--
    El nodo central del colegio suele estar en la intranet, con frecuencia sin
    TLS o con un certificado propio. La app acepta tráfico claro porque de otro
    modo no podría hablar con ese servidor, y confía en las anclas del sistema y
    en las que el administrador instale en el dispositivo.

    Si la institución publica el nodo con un certificado válido, conviene poner
    cleartextTrafficPermitted en "false": el token del equipo viaja en la
    cabecera Authorization y sin TLS podría leerse en la red local.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Las dos advertencias de lint son decisiones conscientes y están
         explicadas arriba: sin HTTP no se puede hablar con una intranet que
         no publica TLS, y la CA institucional la instala el administrador. -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration,AcceptsUserCertificates">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
